# Meterless Nightshift — primary AI provider (verified working)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=<Runtime API key from Nightshift Console>
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris — data layer
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<the key you just created>

# Optional, used only by the ingestion scripts
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Runtime
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000